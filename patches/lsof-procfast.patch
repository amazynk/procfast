292 /** Close handle and free resources. */
293 static inline void procfast_close(struct procfast_handle *h) {
294     if (!h) return;
295     procfast__close_map(&h->cpu);
296     procfast__close_map(&h->mem);
297     procfast__close_map(&h->net);
