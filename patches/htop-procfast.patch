+    attr.map_fd = h->sock_entries_fd;
+    attr.key = (uint64_t)(unsigned long)&inode;
+    attr.value = (uint64_t)(unsigned long)out;
+
+    return (int)syscall(SYS_bpf, BPF_MAP_LOOKUP_ELEM, &attr, sizeof(attr));
+}
