500     attr.value = (uint64_t)(unsigned long)out;
501 
502     return (int)syscall(SYS_bpf, BPF_MAP_LOOKUP_ELEM, &attr, sizeof(attr));
503 }
504 
505 /**
506  * Look up socket info by inode number.
507  * Returns 0 on success, -1 if not found.
508  */
509 static inline int procfast_read_sock(struct procfast_handle *h, uint64_t inode,
510                                       struct procfast_sock_info *out) {
511     if (!procfast_has(h, PROCFAST_HAS_SOCK)) return -1;
512 
513     union bpf_attr attr;
514     memset(&attr, 0, sizeof(attr));
515     attr.map_fd = h->sock_entries_fd;
516     attr.key = (uint64_t)(unsigned long)&inode;
517     attr.value = (uint64_t)(unsigned long)out;
518 
519     return (int)syscall(SYS_bpf, BPF_MAP_LOOKUP_ELEM, &attr, sizeof(attr));
520 }
521 
