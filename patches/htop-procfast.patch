+static void LinuxProcessTable_scanProcfast(LinuxProcessTable* this, const LinuxMachine* lhost) {
+   ProcessTable* pt = (ProcessTable*) this;
+   Machine* host = &((LinuxMachine*)lhost)->super;
+
+   /* Reset counters — they accumulate per scan */
+   pt->totalTasks = 0;
+   pt->userlandThreads = 0;
+   pt->kernelThreads = 0;
+   pt->runningTasks = 0;
+
+   struct procfast_proc_stats* procs = NULL;
+   int nprocs = procfast_read_procs(procfast_handle, &procs);
+   if (nprocs < 0)
+      return;
+
+   long hz = sysconf(_SC_CLK_TCK);
+   if (hz <= 0) hz = 100;
+   double ns_per_jiffy = 1e9 / (double)hz;
+
+   /* Check if it's time to refresh command lines */
+   bool procfast_cmdline_needs_refresh = false;
+   if (procfast_cmdline_refresh_interval > 0) {
+      static time_t last_cmdline_refresh = 0;
+      time_t now = time(NULL);
+      if (now - last_cmdline_refresh >= procfast_cmdline_refresh_interval) {
+         procfast_cmdline_needs_refresh = true;
+         last_cmdline_refresh = now;
+      }
+   }
+
+   for (int i = 0; i < nprocs; i++) {
+      const struct procfast_proc_stats* kp = &procs[i];
+      pid_t pid = (pid_t)kp->pid;
+
+      if (pid <= 0 || kp->state >= 4) /* skip dead/zombie */
+         continue;
+
+      bool preExisting;
+      Process* proc = ProcessTable_getProcess(pt, pid, &preExisting, LinuxProcess_new);
+      LinuxProcess* lp = (LinuxProcess*) proc;
+
+      Process_setThreadGroup(proc, pid);
+      proc->isUserlandThread = false;
+
+      /* State: map procfast values to htop ProcessState */
+      switch (kp->state) {
+         case 0: proc->state = RUNNING; break;
+         case 1: proc->state = SLEEPING; break;
+         case 2: proc->state = UNINTERRUPTIBLE_WAIT; break;
+         case 3: proc->state = STOPPED; break;
+         default: proc->state = SLEEPING; break;
+      }
+
+      Process_setParent(proc, (pid_t)kp->ppid);
+      proc->nlwp = kp->nr_threads > 0 ? (long int)kp->nr_threads : 1;
+      proc->nice = kp->nice;
+      proc->processor = (int)kp->last_cpu;
+
+      /* Priority: match kernel's task_prio() logic */
+      if (kp->policy == 1 || kp->policy == 2) {
+         /* SCHED_FIFO/RR: RT priority shown as negative */
+         proc->priority = -1 - (long int)kp->rt_priority;
+      } else {
+         proc->priority = (long int)kp->nice + 20;
+      }
+
+      #ifdef SCHEDULER_SUPPORT
+      proc->scheduling_policy = (int)kp->policy;
+      #endif
+
+      /* CPU times in jiffies */
+      lp->utime = (unsigned long long)(kp->utime_ns / ns_per_jiffy);
+      lp->stime = (unsigned long long)(kp->stime_ns / ns_per_jiffy);
+      lp->cutime = (unsigned long long)(kp->cutime_ns / ns_per_jiffy);
+      lp->cstime = (unsigned long long)(kp->cstime_ns / ns_per_jiffy);
+
+      /* Memory: procfast gives bytes, htop wants kB */
+      proc->m_resident = (long)(kp->rss_bytes / 1024);
+      proc->m_virt = (long)(kp->vsize_bytes / 1024);
+      lp->m_share = (long)(kp->shared_bytes / 1024);
+
+      /* Context switches */
+      unsigned long ctxt = (unsigned long)(kp->vol_ctxsw + kp->invol_ctxsw);
+      lp->ctxt_diff = (ctxt > lp->ctxt_total) ? ctxt - lp->ctxt_total : 0;
+      lp->ctxt_total = ctxt;
+
+      /* CPU% — use cpu_runtime_ns (accumulated from sched_stat_runtime)
+       * for accurate delta-based CPU%, avoiding tick-based utime/stime jumps */
+      {
+         unsigned long long int runtime_jiffies = (unsigned long long)(kp->cpu_runtime_ns / ns_per_jiffy);
+         unsigned long long int prev_runtime = proc->time;
+         proc->time = runtime_jiffies;
+         float percent_cpu = 0.0;
+         if (lhost->period > 0.0 && preExisting) {
+            unsigned long long int delta = saturatingSub(runtime_jiffies, prev_runtime);
+            float wall_period = lhost->period / host->activeCPUs;
+            if (wall_period > 0.0)
+               percent_cpu = (float)delta / wall_period * 100.0;
+         }
+         proc->percent_cpu = CLAMP(percent_cpu, 0.0F, host->activeCPUs * 100.0F);
+      }
+      proc->percent_mem = host->totalMem > 0
+         ? proc->m_resident / (double)(host->totalMem) * 100.0 : 0.0;
+      Process_updateCPUFieldWidths(proc->percent_cpu);
+
+      /* User */
+      if (proc->st_uid != (uid_t)kp->uid) {
+         proc->st_uid = (uid_t)kp->uid;
+         proc->user = UsersTable_getRef(host->usersTable, proc->st_uid);
+      }
+
+      /* Start time */
+      if (proc->starttime_ctime == 0 && kp->start_time_ns > 0) {
+         proc->starttime_ctime = lhost->boottime + (time_t)(kp->start_time_ns / 1000000000ULL);
+         Process_fillStarttimeBuffer(proc);
+      }
+
+      /* Kernel thread detection: ppid=2 (kthreadd) or pid=2 */
+      proc->isKernelThread = (kp->ppid == 2 || kp->pid == 2);
+      proc->isUserlandThread = false;
+
+      /* Command line: read /proc/[pid]/cmdline when we don't have it yet,
+       * or periodically if --procfast-cmdline-refresh is set. */
+      {
+         bool needCmdline = !proc->cmdline || !proc->cmdline[0];
+         if (!needCmdline && procfast_cmdline_refresh_interval > 0 && procfast_cmdline_needs_refresh) {
+            needCmdline = true;
+         }
+         if (needCmdline) {
+            char path[64];
+            xSnprintf(path, sizeof(path), "/proc/%d", pid);
+            #ifdef HAVE_OPENAT
+            int procFd = open(path, O_RDONLY | O_DIRECTORY);
+            if (procFd >= 0) {
+               LinuxProcessTable_readCmdlineFile(proc, procFd, NULL);
+               close(procFd);
+            }
+            #endif
+            if (!proc->cmdline || !proc->cmdline[0]) {
+               Process_updateCmdline(proc, kp->comm, 0, strlen(kp->comm));
+            }
+         }
+      }
+
+      if (!preExisting) {
+         ProcessTable_add(pt, proc);
+      }
+
+      proc->super.updated = true;
+
+      if (proc->isKernelThread) {
+         pt->kernelThreads++;
+      } else if (proc->nlwp > 1) {
+         /* Count extra threads per process. totalTasks must include
+          * all threads (not just leaders) for htop's Tasks meter math:
+          * "processes = totalTasks - kernelThreads - userlandThreads" */
+         unsigned int extra = (unsigned int)(proc->nlwp - 1);
+         pt->userlandThreads += extra;
+         pt->totalTasks += extra;
+      }
+
+      if (proc->state == RUNNING)
+         pt->runningTasks++;
+
+      proc->super.show = true;
+      pt->totalTasks++; /* count the leader */
+   }
+
+   free(procs);
+}
+
 void ProcessTable_goThroughEntries(ProcessTable* super) {
    LinuxProcessTable* this = (LinuxProcessTable*) super;
    Machine* host = super->super.host;
@@ -1975,6 +2148,11 @@ void ProcessTable_goThroughEntries(ProcessTable* super) {
       }
    }
 
+   if (procfast_data_available()) {
+      LinuxProcessTable_scanProcfast(this, lhost);
+      return;
+   }
+
    /* PROCDIR is an absolute path */
    assert(PROCDIR[0] == '/');
