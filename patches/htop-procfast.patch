diff --git a/linux/ProcfastData.c b/linux/ProcfastData.c
new file mode 100644
index 0000000..4ce3c6f
--- /dev/null
+++ b/linux/ProcfastData.c
@@ -0,0 +1,28 @@
+/*
+htop - linux/ProcfastData.c
+Procfast integration — read system metrics from BPF maps instead of /proc.
+Released under the GNU GPLv2+.
+*/
+
+#include "linux/ProcfastData.h"
+
+#include <stdio.h>
+
+struct procfast_handle* procfast_handle = NULL;
+int procfast_cmdline_refresh_interval = 0;
+
+int procfast_data_init(void) {
+   procfast_handle = procfast_open(NULL);  /* uses default /sys/fs/bpf/procfast */
+   return procfast_handle != NULL ? 1 : 0;
+}
+
+void procfast_data_close(void) {
+   if (procfast_handle) {
+      procfast_close(procfast_handle);
+      procfast_handle = NULL;
+   }
+}
+
+int procfast_data_available(void) {
+   return procfast_handle != NULL ? 1 : 0;
+}
diff --git a/linux/ProcfastData.h b/linux/ProcfastData.h
