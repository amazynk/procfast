292 /** Close handle and free resources. */
293 static inline void procfast_close(struct procfast_handle *h) {
294     if (!h) return;
295     procfast__close_map(&h->cpu);
296     procfast__close_map(&h->mem);
297     procfast__close_map(&h->net);
298     procfast__close_map(&h->proc_header);
299     if (h->proc_stats_fd >= 0) close(h->proc_stats_fd);
300     if (h->fd_entries_fd >= 0) close(h->fd_entries_fd);
301     if (h->sock_entries_fd >= 0) close(h->sock_entries_fd);
302     free(h);
303 }
