496     union bpf_attr attr;
497     memset(&attr, 0, sizeof(attr));
498     attr.map_fd = h->fd_entries_fd;
499     attr.key = (uint64_t)(unsigned long)&key;
500     attr.value = (uint64_t)(unsigned long)out;
501 
502     return (int)syscall(SYS_bpf, BPF_MAP_LOOKUP_ELEM, &attr, sizeof(attr));
503 }
