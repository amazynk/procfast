diff --git a/library/procfast_data.c b/library/procfast_data.c
new file mode 100644
index 0000000..619aaf7
--- /dev/null
+++ b/library/procfast_data.c
@@ -0,0 +1,29 @@
+/*
+ * procfast_data.c - procfast integration for libproc2
+ *
+ * Global handle and init/close/available functions for procfast.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#include "procfast_data.h"
+
+#include <stdio.h>
+
+struct procfast_handle *procfast_handle = NULL;
+
+int procfast_data_init(void) {
+    procfast_handle = procfast_open(NULL);  /* uses default /sys/fs/bpf/procfast */
+    return procfast_handle != NULL ? 1 : 0;
+}
+
+void procfast_data_close(void) {
+    if (procfast_handle) {
+        procfast_close(procfast_handle);
+        procfast_handle = NULL;
+    }
+}
+
+int procfast_data_available(void) {
+    return procfast_handle != NULL ? 1 : 0;
+}
