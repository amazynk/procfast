--- /dev/null
+++ b/library/include/procfast_data.h
@@ -0,0 +1,27 @@
+/*
+ * procfast_data.h - procfast integration for libproc2
+ *
+ * Provides a global procfast handle and init/close/available functions
+ * so that stat.c, meminfo.c, and readproc.c can read from BPF maps
+ * instead of /proc when --procfast is enabled.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#ifndef PROCPS_PROCFAST_DATA_H
+#define PROCPS_PROCFAST_DATA_H
+
+#include "procfast_client.h"
+
+extern struct procfast_handle *procfast_handle;
+
+/* Try to connect to the procfast daemon. Returns 1 on success, 0 on failure. */
+int procfast_data_init(void);
+
+/* Close the procfast connection and free resources. */
+void procfast_data_close(void);
+
+/* Returns 1 if procfast_handle is valid and usable. */
+int procfast_data_available(void);
+
+#endif /* PROCPS_PROCFAST_DATA_H */
