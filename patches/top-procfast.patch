+    if (procfast_data_available()) {
+        struct procfast_mem_data procfast_mem;
+        if (procfast_read_mem(procfast_handle, &procfast_mem) == 0) {
+            /* procfast reports bytes; meminfo_data uses kB */
+            mHr(MemTotal)      = procfast_mem.total_bytes / 1024;
+            mHr(MemFree)       = procfast_mem.free_bytes / 1024;
+            mHr(MemAvailable)  = procfast_mem.available_bytes / 1024;
+            mHr(Buffers)       = procfast_mem.buffers_bytes / 1024;
+            mHr(Cached)        = procfast_mem.cached_bytes / 1024;
+            mHr(SwapTotal)     = procfast_mem.swap_total_bytes / 1024;
+            mHr(SwapFree)      = procfast_mem.swap_free_bytes / 1024;
+            mHr(Active)        = procfast_mem.active_bytes / 1024;
+            mHr(Inactive)      = procfast_mem.inactive_bytes / 1024;
+            mHr(SReclaimable)  = procfast_mem.slab_reclaimable_bytes / 1024;
+            mHr(SUnreclaim)    = procfast_mem.slab_unreclaimable_bytes / 1024;
+            mHr(Slab)          = mHr(SReclaimable) + mHr(SUnreclaim);
+            mHr(Dirty)         = procfast_mem.dirty_bytes / 1024;
+            mHr(Writeback)     = procfast_mem.writeback_bytes / 1024;
+            mHr(Shmem)         = procfast_mem.shmem_bytes / 1024;
+
+            if (0 == mHr(MemAvailable))
+                mHr(MemAvailable) = mHr(MemFree);
+            mHr(derived_mem_cached) = mHr(Cached) + mHr(SReclaimable);
+
+            if (mHr(MemAvailable) > mHr(MemTotal))
+                mHr(MemAvailable) = mHr(MemFree);
+            {
+                signed long mem_used = mHr(MemTotal) - mHr(MemAvailable);
+                if (mem_used < 0)
+                    mem_used = mHr(MemTotal) - mHr(MemFree);
+                mHr(derived_mem_used) = (unsigned long)mem_used;
+            }
+
+            if (mHr(SwapFree) < mHr(SwapTotal))
+                mHr(derived_swap_used) = mHr(SwapTotal) - mHr(SwapFree);
+
+            return 0;
+        }
+    }
+
     if (-1 == info->meminfo_fd
     && (-1 == (info->meminfo_fd = open(MEMINFO_FILE, O_RDONLY))))
         return 1;
