239     struct procfast_handle *h = (struct procfast_handle *)calloc(1, sizeof(*h));
240     if (!h) return NULL;
241 
242     h->proc_stats_fd = -1;
243     h->fd_entries_fd = -1;
244     h->sock_entries_fd = -1;
245     h->available = 0;
246 
247     if (procfast__open_map(pin_dir, "cpu_data", &h->cpu,
248                        sizeof(struct procfast_cpu_data)) == 0)
249         h->available |= PROCFAST_HAS_CPU;
250 
251     if (procfast__open_map(pin_dir, "mem_data", &h->mem,
252                        sizeof(struct procfast_mem_data)) == 0)
253         h->available |= PROCFAST_HAS_MEM;
254 
255     if (procfast__open_map(pin_dir, "net_data", &h->net,
256                        sizeof(struct procfast_net_data)) == 0)
257         h->available |= PROCFAST_HAS_NET;
258 
259     if (procfast__open_map(pin_dir, "proc_header", &h->proc_header,
260                        sizeof(struct procfast_proc_header)) == 0) {
261         char path[256];
262         snprintf(path, sizeof(path), "%s/proc_stats", pin_dir);
263         h->proc_stats_fd = procfast__bpf_obj_get(path);
264         if (h->proc_stats_fd >= 0)
265             h->available |= PROCFAST_HAS_PROC;
266     }
267 
268     {
269         char path[256];
270         snprintf(path, sizeof(path), "%s/fd_entries", pin_dir);
271         h->fd_entries_fd = procfast__bpf_obj_get(path);
272         if (h->fd_entries_fd >= 0)
273             h->available |= PROCFAST_HAS_FD;
274     }
275 
276     {
