311 static inline int procfast_read_cpu(struct procfast_handle *h, struct procfast_cpu_data *out) {
312     if (!procfast_has(h, PROCFAST_HAS_CPU)) return -1;
313     procfast__seqlock_read(h->cpu.addr, out, sizeof(*out));
