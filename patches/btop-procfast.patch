172 static inline int procfast__bpf_obj_get(const char *path) {
173     union bpf_attr attr;
174     memset(&attr, 0, sizeof(attr));
175     attr.pathname = (uint64_t)(unsigned long)path;
176     return (int)syscall(SYS_bpf, BPF_OBJ_GET, &attr, sizeof(attr));
177 }
178 
179 static inline int procfast__open_map(const char *dir, const char *name,
180                                   struct procfast_mmap *mm, size_t value_size) {
181     char path[256];
182     snprintf(path, sizeof(path), "%s/%s", dir, name);
183 
184     int fd = procfast__bpf_obj_get(path);
185     if (fd < 0) return -1;
186 
187     void *addr = mmap(NULL, value_size, PROT_READ, MAP_SHARED, fd, 0);
188     if (addr == MAP_FAILED) {
189         close(fd);
190         return -1;
191     }
192 
193     mm->addr = addr;
194     mm->len = value_size;
195     mm->fd = fd;
196     return 0;
197 }
198 
199 static inline void procfast__close_map(struct procfast_mmap *mm) {
200     if (mm->addr && mm->addr != MAP_FAILED) {
201         munmap(mm->addr, mm->len);
202         mm->addr = NULL;
203     }
204     if (mm->fd >= 0) {
205         close(mm->fd);
206         mm->fd = -1;
207     }
208 }
