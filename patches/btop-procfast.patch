@@ -0,0 +1,29 @@
+/*
+ * btop - linux/procfast_data.hpp
+ * Procfast integration — read system metrics from BPF maps instead of /proc.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#pragma once
+
+#include "procfast_client.h"
+
+namespace Procfast {
+	inline struct procfast_handle* handle = nullptr;
+
+	inline bool init() {
+		handle = procfast_open(nullptr); // uses default /sys/fs/bpf/procfast
+		return handle != nullptr;
+	}
+
+	inline void close() {
+		if (handle) {
+			procfast_close(handle);
+			handle = nullptr;
+		}
+	}
+
+	inline bool available() {
+		return handle != nullptr;
+	}
+}
