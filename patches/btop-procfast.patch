331 /**
332  * Read all tracked processes via batch lookup.
333  * Allocates *out_procs (caller must free). Returns count, or -1 on error.
334  */
335 static inline int procfast_read_procs(struct procfast_handle *h,
336                                    struct procfast_proc_stats **out_procs) {
337     if (!procfast_has(h, PROCFAST_HAS_PROC)) return -1;
338 
339     struct procfast_proc_header hdr;
340     procfast__seqlock_read(h->proc_header.addr, &hdr, sizeof(hdr));
341 
342     size_t capacity = hdr.nr_procs > 0 ? hdr.nr_procs + 64 : 1024;
343     struct procfast_proc_stats *procs = (struct procfast_proc_stats *)
344         malloc(capacity * sizeof(struct procfast_proc_stats));
345     if (!procs) return -1;
346 
347     int fd = h->proc_stats_fd;
348     uint32_t key_size = sizeof(uint32_t);
349     uint32_t val_size = sizeof(struct procfast_proc_stats);
350     uint32_t batch = 512;
351 
352     uint32_t *keys = (uint32_t *)malloc(batch * key_size);
353     struct procfast_proc_stats *vals = (struct procfast_proc_stats *)
354         malloc(batch * val_size);
355     if (!keys || !vals) {
356         free(keys); free(vals); free(procs);
357         return -1;
358     }
359 
360     int total = 0;
361     uint64_t in_batch = 0, out_batch = 0;
362     int first = 1;
363 
364     struct { uint64_t sz, elem_flags, flags; } opts = {
365         .sz = sizeof(opts), .elem_flags = 0, .flags = 0
366     };
367 
368     for (;;) {
369         uint32_t count = batch;
370 
371         union bpf_attr attr;
372         memset(&attr, 0, sizeof(attr));
373         attr.batch.map_fd = fd;
374         attr.batch.in_batch = first ? 0 : (uint64_t)(unsigned long)&in_batch;
375         attr.batch.out_batch = (uint64_t)(unsigned long)&out_batch;
376         attr.batch.keys = (uint64_t)(unsigned long)keys;
377         attr.batch.values = (uint64_t)(unsigned long)vals;
378         attr.batch.count = count;
379 
380         int ret = (int)syscall(SYS_bpf, BPF_MAP_LOOKUP_BATCH,
381                                &attr, sizeof(attr));
382         count = attr.batch.count;
383         first = 0;
384 
385         for (uint32_t i = 0; i < count; i++) {
386             if ((size_t)total >= capacity) {
387                 capacity *= 2;
388                 procs = (struct procfast_proc_stats *)
389                     realloc(procs, capacity * sizeof(*procs));
390                 if (!procs) { free(keys); free(vals); return -1; }
391             }
392             procs[total++] = vals[i];
393         }
394 
395         in_batch = out_batch;
396         if (ret != 0) break; /* ENOENT = done */
397     }
398 
399     free(keys);
400     free(vals);
401     *out_procs = procs;
402     return total;
403 }
404 
405 /**
406  * Look up a single process by PID. Returns 0 on success, -1 if not found.
407  */
408 static inline int procfast_read_proc(struct procfast_handle *h, uint32_t pid,
409                                   struct procfast_proc_stats *out) {
410     if (!procfast_has(h, PROCFAST_HAS_PROC)) return -1;
411 
412     union bpf_attr attr;
413     memset(&attr, 0, sizeof(attr));
414     attr.map_fd = h->proc_stats_fd;
415     attr.key = (uint64_t)(unsigned long)&pid;
416     attr.value = (uint64_t)(unsigned long)out;
417 
418     return (int)syscall(SYS_bpf, BPF_MAP_LOOKUP_ELEM, &attr, sizeof(attr));
419 }
