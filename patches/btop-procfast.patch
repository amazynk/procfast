210 /* Seqlock read: copy data while sequence counter is stable */
211 static inline void procfast__seqlock_read(const void *src, void *dst, size_t len) {
212     const volatile uint64_t *seq = (const volatile uint64_t *)src;
213     for (;;) {
214         uint64_t s1 = *seq;
215         if (s1 & 1) { /* writer active */
216             __asm__ __volatile__("pause" ::: "memory");
217             continue;
218         }
219         __atomic_thread_fence(__ATOMIC_ACQUIRE);
220         memcpy(dst, (const void *)src, len);
221         __atomic_thread_fence(__ATOMIC_ACQUIRE);
222         uint64_t s2 = *seq;
223         if (s1 == s2) return;
224     }
225 }
