421 /**
422  * Read all tracked file descriptors via batch lookup.
423  * Allocates *out_fds (caller must free). Returns count, or -1 on error.
424  */
425 static inline int procfast_read_fds(struct procfast_handle *h,
426                                  struct procfast_fd_info **out_fds) {
427     if (!procfast_has(h, PROCFAST_HAS_FD)) return -1;
428 
429     size_t capacity = 4096;
430     struct procfast_fd_info *fds = (struct procfast_fd_info *)
431         malloc(capacity * sizeof(struct procfast_fd_info));
432     if (!fds) return -1;
433 
434     int fd = h->fd_entries_fd;
435     uint32_t batch = 512;
436 
437     uint64_t *keys = (uint64_t *)malloc(batch * sizeof(uint64_t));
438     struct procfast_fd_info *vals = (struct procfast_fd_info *)
439         malloc(batch * sizeof(struct procfast_fd_info));
440     if (!keys || !vals) {
441         free(keys); free(vals); free(fds);
442         return -1;
443     }
444 
445     int total = 0;
446     uint64_t in_batch = 0, out_batch = 0;
447     int first = 1;
448 
449     for (;;) {
450         uint32_t count = batch;
451 
452         union bpf_attr attr;
453         memset(&attr, 0, sizeof(attr));
454         attr.batch.map_fd = fd;
455         attr.batch.in_batch = first ? 0 : (uint64_t)(unsigned long)&in_batch;
456         attr.batch.out_batch = (uint64_t)(unsigned long)&out_batch;
457         attr.batch.keys = (uint64_t)(unsigned long)keys;
458         attr.batch.values = (uint64_t)(unsigned long)vals;
459         attr.batch.count = count;
460 
461         int ret = (int)syscall(SYS_bpf, BPF_MAP_LOOKUP_BATCH,
462                                &attr, sizeof(attr));
463         count = attr.batch.count;
464         first = 0;
465 
466         for (uint32_t i = 0; i < count; i++) {
467             if ((size_t)total >= capacity) {
468                 capacity *= 2;
469                 fds = (struct procfast_fd_info *)
470                     realloc(fds, capacity * sizeof(*fds));
471                 if (!fds) { free(keys); free(vals); return -1; }
472             }
473             fds[total++] = vals[i];
474         }
475 
476         in_batch = out_batch;
477         if (ret != 0) break; /* ENOENT = done */
478     }
479 
480     free(keys);
481     free(vals);
482     *out_fds = fds;
483     return total;
484 }
