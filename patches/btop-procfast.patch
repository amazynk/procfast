486 /**
487  * Look up a single file descriptor by PID + fd number.
488  * Returns 0 on success, -1 if not found.
489  */
490 static inline int procfast_read_fd(struct procfast_handle *h, uint32_t pid,
491                                 uint32_t fd_num, struct procfast_fd_info *out) {
492     if (!procfast_has(h, PROCFAST_HAS_FD)) return -1;
493 
494     uint64_t key = ((uint64_t)pid << 32) | fd_num;
495 
496     union bpf_attr attr;
497     memset(&attr, 0, sizeof(attr));
498     attr.map_fd = h->fd_entries_fd;
499     attr.key = (uint64_t)(unsigned long)&key;
500     attr.value = (uint64_t)(unsigned long)out;
501 
502     return (int)syscall(SYS_bpf, BPF_MAP_LOOKUP_ELEM, &attr, sizeof(attr));
503 }
