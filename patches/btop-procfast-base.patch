353 /**
354  * Look up a single process by PID. Returns 0 on success, -1 if not found.
355  */
356 static inline int procfast_read_proc(struct procfast_handle *h, uint32_t pid,
357                                   struct procfast_proc_stats *out) {
358     if (!procfast_has(h, PROCFAST_HAS_PROC)) return -1;
359 
360     union bpf_attr attr;
361     memset(&attr, 0, sizeof(attr));
362     attr.map_fd = h->proc_stats_fd;
363     attr.key = (uint64_t)(unsigned long)&pid;
364     attr.value = (uint64_t)(unsigned long)out;
365 
366     return (int)syscall(SYS_bpf, BPF_MAP_LOOKUP_ELEM, &attr, sizeof(attr));
367 }
