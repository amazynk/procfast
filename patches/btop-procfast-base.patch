197 /**
198  * Open a connection to procfast's pinned maps.
199  * Returns NULL if procfast daemon is not running.
200  */
201 static inline struct procfast_handle *procfast_open(const char *pin_dir) {
202     if (!pin_dir) pin_dir = "/sys/fs/bpf/procfast";
203 
204     struct stat st;
205     if (stat(pin_dir, &st) != 0) return NULL;
206 
207     struct procfast_handle *h = (struct procfast_handle *)calloc(1, sizeof(*h));
208     if (!h) return NULL;
209 
210     h->proc_stats_fd = -1;
211     h->available = 0;
212 
213     if (procfast__open_map(pin_dir, "cpu_data", &h->cpu,
214                        sizeof(struct procfast_cpu_data)) == 0)
215         h->available |= PROCFAST_HAS_CPU;
216 
217     if (procfast__open_map(pin_dir, "mem_data", &h->mem,
218                        sizeof(struct procfast_mem_data)) == 0)
219         h->available |= PROCFAST_HAS_MEM;
220 
221     if (procfast__open_map(pin_dir, "net_data", &h->net,
222                        sizeof(struct procfast_net_data)) == 0)
223         h->available |= PROCFAST_HAS_NET;
224 
225     if (procfast__open_map(pin_dir, "proc_header", &h->proc_header,
226                        sizeof(struct procfast_proc_header)) == 0) {
227         char path[256];
228         snprintf(path, sizeof(path), "%s/proc_stats", pin_dir);
229         h->proc_stats_fd = procfast__bpf_obj_get(path);
230         if (h->proc_stats_fd >= 0)
231             h->available |= PROCFAST_HAS_PROC;
232     }
233 
234     if (h->available == 0) {
235         free(h);
236         return NULL;
237     }
238 
239     return h;
240 }
241 
242 /** Close handle and free resources. */
243 static inline void procfast_close(struct procfast_handle *h) {
244     if (!h) return;
245     procfast__close_map(&h->cpu);
246     procfast__close_map(&h->mem);
247     procfast__close_map(&h->net);
248     procfast__close_map(&h->proc_header);
249     if (h->proc_stats_fd >= 0) close(h->proc_stats_fd);
250     free(h);
251 }
