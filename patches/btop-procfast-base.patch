178 /* Seqlock read: copy data while sequence counter is stable */
179 static inline void procfast__seqlock_read(const void *src, void *dst, size_t len) {
180     const volatile uint64_t *seq = (const volatile uint64_t *)src;
181     for (;;) {
182         uint64_t s1 = *seq;
183         if (s1 & 1) { /* writer active */
184             __asm__ __volatile__("pause" ::: "memory");
185             continue;
186         }
187         __atomic_thread_fence(__ATOMIC_ACQUIRE);
188         memcpy(dst, (const void *)src, len);
189         __atomic_thread_fence(__ATOMIC_ACQUIRE);
190         uint64_t s2 = *seq;
191         if (s1 == s2) return;
192     }
193 }
