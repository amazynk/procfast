147 static inline int procfast__open_map(const char *dir, const char *name,
148                                   struct procfast_mmap *mm, size_t value_size) {
149     char path[256];
150     snprintf(path, sizeof(path), "%s/%s", dir, name);
151 
152     int fd = procfast__bpf_obj_get(path);
153     if (fd < 0) return -1;
154 
155     void *addr = mmap(NULL, value_size, PROT_READ, MAP_SHARED, fd, 0);
156     if (addr == MAP_FAILED) {
157         close(fd);
158         return -1;
159     }
160 
161     mm->addr = addr;
162     mm->len = value_size;
163     mm->fd = fd;
164     return 0;
165 }
166 
167 static inline void procfast__close_map(struct procfast_mmap *mm) {
168     if (mm->addr && mm->addr != MAP_FAILED) {
169         munmap(mm->addr, mm->len);
170         mm->addr = NULL;
171     }
172     if (mm->fd >= 0) {
173         close(mm->fd);
174         mm->fd = -1;
175     }
176 }
