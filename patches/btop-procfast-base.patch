140 static inline int procfast__bpf_obj_get(const char *path) {
141     union bpf_attr attr;
142     memset(&attr, 0, sizeof(attr));
143     attr.pathname = (uint64_t)(unsigned long)path;
144     return (int)syscall(SYS_bpf, BPF_OBJ_GET, &attr, sizeof(attr));
145 }
