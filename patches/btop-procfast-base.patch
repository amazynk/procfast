279 /**
280  * Read all tracked processes via batch lookup.
281  * Allocates *out_procs (caller must free). Returns count, or -1 on error.
282  */
283 static inline int procfast_read_procs(struct procfast_handle *h,
284                                    struct procfast_proc_stats **out_procs) {
285     if (!procfast_has(h, PROCFAST_HAS_PROC)) return -1;
286 
287     struct procfast_proc_header hdr;
288     procfast__seqlock_read(h->proc_header.addr, &hdr, sizeof(hdr));
289 
290     size_t capacity = hdr.nr_procs > 0 ? hdr.nr_procs + 64 : 1024;
291     struct procfast_proc_stats *procs = (struct procfast_proc_stats *)
292         malloc(capacity * sizeof(struct procfast_proc_stats));
293     if (!procs) return -1;
294 
295     int fd = h->proc_stats_fd;
296     uint32_t key_size = sizeof(uint32_t);
297     uint32_t val_size = sizeof(struct procfast_proc_stats);
298     uint32_t batch = 512;
299 
300     uint32_t *keys = (uint32_t *)malloc(batch * key_size);
301     struct procfast_proc_stats *vals = (struct procfast_proc_stats *)
302         malloc(batch * val_size);
303     if (!keys || !vals) {
304         free(keys); free(vals); free(procs);
305         return -1;
306     }
307 
308     int total = 0;
309     uint64_t in_batch = 0, out_batch = 0;
310     int first = 1;
311 
312     struct { uint64_t sz, elem_flags, flags; } opts = {
313         .sz = sizeof(opts), .elem_flags = 0, .flags = 0
314     };
315 
316     for (;;) {
317         uint32_t count = batch;
318 
319         union bpf_attr attr;
320         memset(&attr, 0, sizeof(attr));
321         attr.batch.map_fd = fd;
322         attr.batch.in_batch = first ? 0 : (uint64_t)(unsigned long)&in_batch;
323         attr.batch.out_batch = (uint64_t)(unsigned long)&out_batch;
324         attr.batch.keys = (uint64_t)(unsigned long)keys;
325         attr.batch.values = (uint64_t)(unsigned long)vals;
326         attr.batch.count = count;
327 
328         int ret = (int)syscall(SYS_bpf, BPF_MAP_LOOKUP_BATCH,
329                                &attr, sizeof(attr));
330         count = attr.batch.count;
331         first = 0;
332 
333         for (uint32_t i = 0; i < count; i++) {
334             if ((size_t)total >= capacity) {
335                 capacity *= 2;
336                 procs = (struct procfast_proc_stats *)
337                     realloc(procs, capacity * sizeof(*procs));
338                 if (!procs) { free(keys); free(vals); return -1; }
339             }
340             procs[total++] = vals[i];
341         }
342 
343         in_batch = out_batch;
344         if (ret != 0) break; /* ENOENT = done */
345     }
346 
347     free(keys);
348     free(vals);
349     *out_procs = procs;
350     return total;
351 }
